POSTGRES_DB=taka_sats
POSTGRES_USER=taka_sats
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://taka_sats:local-development-only@postgres:5432/taka_sats
APP_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=taka_sats
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET=taka-sats
S3_ENDPOINT=http://minio:9000
S3_BUCKET=taka-sats
S3_REGION=auto
S3_ACCESS_KEY_ID=taka_sats
S3_SECRET_ACCESS_KEY=local-development-only

# Optional single-node Garage overlay (`docker/docker-compose.garage.yml`).
# Access key IDs must start with GK; generate all three values for deployment.
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=taka-sats
GARAGE_S3_PORT=127.0.0.1:9100
NOSTR_RELAY_PORT=8080
LNBITS_PORT=5000
BITCOIN_RPC_PORT=18443
BITCOIN_RPC_USER=taka_sats
BITCOIN_RPC_PASSWORD=local-regtest-only
CRON_SECRET=replace-with-a-random-secret

# Lightning provider secrets (D-21 §13.1) — set only the one matching
# lightning.float_provider in config/settings.toml. Never set in settings.toml.
BLINK_API_KEY=
# The Blink BTC wallet id the hot wallet pays from (not secret). Required with float_provider = "blink".
# `pnpm provider:check` reads its balance and refuses a wallet that is not the BTC wallet.
TAKASATS__LIGHTNING__BLINK__FLOAT_WALLET_ID=
LNBITS_ADMIN_KEY=
# LNbits `usermanager` extension key — only needed when custody.provisioning_enabled
# (per-collector wallet minting, M1-6, gate G1). Distinct from LNBITS_ADMIN_KEY.
LNBITS_USERMANAGER_KEY=
# Production guard for the demo rail: lightning.float_provider = "fake" marks payouts paid
# WITHOUT sending anything, so the app refuses it when NODE_ENV=production unless this is "true".
# Leave unset on any deployment that moves real money.
TAKASATS_ALLOW_FAKE_PROVIDER=

# Auth.js JWT signing secret (M2-1). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret

# Optional frontend-only reverse proxy. Set on Vercel to the full-stack VM origin
# (for example https://taka.novyrix.com); leave unset on the VM to serve APIs locally.
TAKASATS_API_ORIGIN=

# Ledger checkpoint signing seed (M4-7): a base64 32-byte Ed25519 seed. Generate with:
#   openssl rand -base64 32
# Back it up. The matching PUBLIC key is served by GET /api/v1/ledger/checkpoints — see docs/LEDGER.md.
LEDGER_SIGNING_KEY=

# Public hostname for the HTTPS overlay (docker/docker-compose.https.yml); Caddy fetches the
# certificate for it. DNS must point at this machine. Example: taka.afribit.africa
TAKASATS_DOMAIN=
