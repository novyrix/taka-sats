# Taka Sats CI receiver settings. Copy to /etc/takasats-ci/ci.env, chmod 600, and fill in.
# This file holds secrets once filled in. It must never be committed (the real file lives
# outside the repository). Every value below is a placeholder.

# --- GitHub ---------------------------------------------------------------------------
# The repository to build, as owner/name.
GITHUB_REPO=your-org/your-repo
# A long random string. Paste the same value into the GitHub webhook "Secret" field.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me
# A fine grained personal access token limited to this one repository with the single
# permission "Commit statuses: Read and write". Leave empty to run without reporting back.
GITHUB_TOKEN=
# Only for GitHub Enterprise Server. Default: https://api.github.com
# GITHUB_API_URL=

# --- What to build --------------------------------------------------------------------
# Comma separated branches built on push, and the only branches pull requests may target.
CI_BRANCHES=main
# Pull requests from forks run the author's code on this machine, so they are ignored unless
# the author is listed here (GitHub user names, comma separated). Same repository pull
# requests are always built.
CI_TRUSTED_USERS=
# The name shown next to the status on GitHub.
CI_STATUS_CONTEXT=ci/self-hosted
# Extra arguments for scripts/ci/run.sh, for example: --skip build or --docker
CI_RUN_ARGS=
# Stop a build that runs longer than this many minutes.
CI_JOB_TIMEOUT_MINUTES=45
# How many past runs (logs and reports) to keep on disk.
CI_KEEP_RUNS=30
# Extra environment variable names passed to the build, comma separated. By default the build
# gets only PATH, HOME, LANG, TMPDIR, DOCKER_HOST and PNPM_HOME, never the values in this file.
# CI_PASS_ENV=

# --- Network --------------------------------------------------------------------------
# Listen address and port. Keep 127.0.0.1 and put a tunnel or reverse proxy in front.
CI_BIND=127.0.0.1
CI_PORT=8787
# The public https address of this receiver, used for the "Details" link on GitHub and in
# notices. Run pages live at <this>/runs/<id>. Leave empty to omit the link.
CI_PUBLIC_URL=https://ci.example.org
# Where repositories and runs are kept. systemd sets this for you with StateDirectory.
# CI_WORKDIR=/var/lib/takasats-ci

# --- Notifications (optional, both can be on) -----------------------------------------
# A notice is sent when a build fails or errors. Set to true to also hear about passes.
NOTIFY_ON_SUCCESS=false

# Telegram. Create a bot with @BotFather, send it a message, then read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Use your own Bot API server if you run one, for example http://127.0.0.1:8081
# TELEGRAM_API_BASE=https://api.telegram.org

# Email through any SMTP server. smtp://host:587 uses STARTTLS, smtps://host:465 uses TLS.
SMTP_URL=
SMTP_FROM=ci@example.org
# Comma separated recipients.
SMTP_TO=maintainer@example.org
SMTP_USER=
SMTP_PASSWORD=
# Defaults to true for smtp:// addresses. Set false only for a local relay without TLS.
# SMTP_STARTTLS=true
